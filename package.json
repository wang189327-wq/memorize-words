{
  "name": "memorize-words",
  "version": "1.1.1",
  "private": true,
  "license": "MIT",
  "description": "Local-first vocabulary learning with optional self-hosted manual sync",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "configure": "node tools/configure.mjs && node tools/build-offline.mjs",
    "generate": "node tools/vendor-fsrs.mjs && node tools/build-offline.mjs",
    "check:generated": "node tools/vendor-fsrs.mjs --check && node tools/build-offline.mjs --check",
    "test": "node tools/test.mjs",
    "test:unit": "node tools/test.mjs --unit",
    "test:browser": "node tools/test.mjs --browser",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:public": "node tools/check-public.mjs",
    "check:config": "node tools/check-config.mjs",
    "lint": "node tools/lint.mjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "esbuild": "0.28.2",
    "eslint-scope": "8.4.0",
    "playwright": "1.62.1",
    "prettier": "3.9.10"
  },
  "overrides": {
    "protobufjs": "7.6.6",
    "buffer": "4.9.2"
  },
  "dependencies": {
    "tablestore": "5.6.6",
    "ts-fsrs": "6.0.0"
  }
}
